{
  "name": "多机位：按拍摄时间段提取",
  "description": "每个机位文件夹里某个时段拍的照片和 RAW，拷到目标里的同名文件夹",
  "order": 1,
  "plan": {
    "rule": {
      "mode": "all",
      "items": [
        {
          "id": "t1",
          "field": "exif.time",
          "op": "timeOfDay",
          "value": [
            "11:38",
            "11:41"
          ]
        },
        {
          "id": "t2",
          "field": "kind",
          "op": "in",
          "value": [
            "photo",
            "raw"
          ]
        }
      ]
    },
    "dest": {
      "template": "{一级文件夹}/{子目录}",
      "action": "copy",
      "conflict": "rename"
    },
    "timeFallback": "mtime"
  }
}